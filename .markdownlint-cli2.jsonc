{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD001": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD009": { "br_spaces": 2 },
    "MD010": true,
    "MD012": { "maximum": 1 },
    "MD013": false,
    "MD014": true,
    "MD022": true,
    "MD025": { "level": 1 },
    "MD029": { "style": "one_or_ordered" },
    "MD031": true,
    "MD032": true,
    "MD033": {
      "allowed_elements": [
        "details",
        "summary",
        "br",
        "sub",
        "sup",
        "kbd",
        "img",
        "a"
      ]
    },
    "MD034": true,
    "MD040": true,
    "MD046": { "style": "fenced" },
    "MD047": true,
    "MD055": { "style": "leading_and_trailing" },
    "MD056": true,
    "MD058": true,
    "MD060": { "style": "aligned" }
  },
  "gitignore": true,
  "ignores": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".git"
  ]
}
